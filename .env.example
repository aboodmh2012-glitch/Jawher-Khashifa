# Development only. Never commit real credentials. Root .env is loaded by API and Vite.
API_PORT=4000
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
AUTH_MODE=demo
DEMO_PASSWORD=demo
# Optional: stable demo token key. Otherwise generated each startup, invalidating old sessions.
# JWT_SECRET=
ORGANIZATION_ID=org-demo
SIM_ENABLED=true
SIM_ASSET_COUNT=8
# Optional single-process persistence. Keep different directories for demo and OIDC.
DATA_DIR=./data/demo
BUS_DRIVER=memory

# To use OIDC: AUTH_MODE=oidc; SIM_ENABLED=false; separate DATA_DIR; organization ID matching tokens.
# Configure administrator-managed orgId + role claims and audience fusion-api.
OIDC_ISSUER=http://localhost:8080/realms/fusion
OIDC_JWKS_URL=http://localhost:8080/realms/fusion/protocol/openid-connect/certs
OIDC_AUDIENCE=fusion-api
# Enable these only when using OIDC. Browser is a public client; no client secret.
# VITE_OIDC_ISSUER=http://localhost:8080/realms/fusion
# VITE_OIDC_CLIENT_ID=fusion-web

VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json

# Future infrastructure, not active storage/bus drivers in this release.
DATABASE_URL=postgres://fusion:fusion@localhost:5432/fusion
TIMESCALE_URL=postgres://fusion:fusion@localhost:5433/fusion_ts
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=fusion
S3_SECRET_KEY=change-me
S3_BUCKET=fusion-media
# Consumed by .mcp.json; provide through environment, never paste credentials in source.
ODOO_MCP_TOKEN=your-fusionlc-bearer-token
