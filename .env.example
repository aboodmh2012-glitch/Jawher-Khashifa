# ── Fusion Operations Platform — environment template ──────────────────────
# Copy to .env and fill in. NEVER commit real credentials.

# Backend (operations-service)
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-production
SIM_ENABLED=true                # generate simulated assets (demo mode)
SIM_ASSET_COUNT=8

# Database (Phase 1+, not required for the MVP demo)
DATABASE_URL=postgres://fusion:fusion@localhost:5432/fusion
TIMESCALE_URL=postgres://fusion:fusion@localhost:5433/fusion_ts

# Object storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=fusion
S3_SECRET_KEY=change-me
S3_BUCKET=fusion-media

# Message bus (NATS / MQTT abstraction)
BUS_DRIVER=memory               # memory | nats | mqtt
NATS_URL=nats://localhost:4222

# Identity (Keycloak / OIDC) — Phase 1+
OIDC_ISSUER=http://localhost:8080/realms/fusion
OIDC_CLIENT_ID=fusion-web
OIDC_CLIENT_SECRET=change-me

# Frontend (Vite)
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json
