<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trip_pricing_rule_action" model="ir.actions.act_window">
        <field name="name">Pricing Rules</field>
        <field name="res_model">fusion.travel.pricing.rule</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="trip_pricing_rule_view_list" model="ir.ui.view">
        <field name="name">fusion.travel.pricing.rule.list</field>
        <field name="model">fusion.travel.pricing.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="priority"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="service_type"/>
                <field name="airline_code"/>
                <field name="city"/>
                <field name="provider"/>
                <field name="fixed_markup"/>
                <field name="percentage_markup"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="trip_pricing_rule_view_form" model="ir.ui.view">
        <field name="name">fusion.travel.pricing.rule.form</field>
        <field name="model">fusion.travel.pricing.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="service_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="priority"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="fixed_markup"/>
                            <field name="percentage_markup"/>
                        </group>
                    </group>
                    <group string="Matching Conditions">
                        <field name="airline_code"/>
                        <field name="city"/>
                        <field name="provider"/>
                        <field name="cabin_class"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
