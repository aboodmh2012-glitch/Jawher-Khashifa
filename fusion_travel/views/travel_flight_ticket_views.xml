<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_flight_ticket_tree" model="ir.ui.view">
    <field name="name">fusion.travel.flight.ticket.list</field><field name="model">fusion.travel.flight.ticket</field>
    <field name="arch" type="xml"><list default_order="issue_date desc"><field name="name"/><field name="booking_id"/><field name="partner_id"/><field name="traveler_name"/><field name="airline_id"/><field name="operation_type"/><field name="issue_date"/><field name="customer_total" sum="Customer Total"/><field name="supplier_net" sum="Supplier Net"/><field name="gross_profit" sum="Gross Profit"/><field name="state" widget="badge"/></list></field>
  </record>
  <record id="view_flight_ticket_form" model="ir.ui.view">
    <field name="name">fusion.travel.flight.ticket.form</field><field name="model">fusion.travel.flight.ticket</field>
    <field name="arch" type="xml"><form><header><button name="action_post" type="object" string="Post" class="btn-primary" groups="fusion_travel.group_fusion_travel_accountant" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="Cancel" groups="fusion_travel.group_fusion_travel_manager" invisible="state == 'cancelled'"/><button name="action_reset_to_draft" type="object" string="Reset to Draft" groups="fusion_travel.group_fusion_travel_manager" invisible="state == 'draft'"/><field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/></header><sheet><group><group><field name="name" readonly="1"/><field name="company_id" groups="base.group_multi_company"/><field name="booking_id"/><field name="partner_id"/><field name="provider_id"/><field name="agent_id"/><field name="traveler_name"/><field name="issue_date"/></group><group><field name="operation_type"/><field name="original_ticket_id" invisible="operation_type == 'issue'" required="operation_type != 'issue'"/><field name="airline_id"/><field name="airline_num"/><field name="airline_number" readonly="1"/><field name="ticket_number"/><field name="pnr"/><field name="currency_id"/><field name="invoice_id" readonly="1"/></group></group><notebook><page string="Supplier"><group><field name="supplier_fare"/><field name="supplier_tax"/><field name="supplier_commission"/><field name="supplier_net" readonly="1"/></group></page><page string="Customer"><group><field name="customer_fare"/><field name="customer_tax"/><field name="service_fee"/><field name="penalty_amount"/><field name="void_fee" invisible="operation_type != 'void'"/><field name="customer_total" readonly="1"/><field name="gross_profit" readonly="1"/></group></page><page string="Accounting"><field name="move_ids" readonly="1"/><field name="attachment_ids" widget="many2many_binary"/></page></notebook></sheet><chatter/></form></field>
  </record>
  <record id="view_flight_ticket_search" model="ir.ui.view"><field name="name">fusion.travel.flight.ticket.search</field><field name="model">fusion.travel.flight.ticket</field><field name="arch" type="xml"><search><field name="ticket_number"/><field name="pnr"/><field name="traveler_name"/><field name="partner_id"/><field name="airline_id"/><filter name="issues" string="Issues" domain="[('operation_type','=','issue')]"/><filter name="refunds" string="Refunds" domain="[('operation_type','=','refund')]"/><group><filter name="group_airline" string="Airline" context="{'group_by':'airline_id'}"/><filter name="group_type" string="Operation" context="{'group_by':'operation_type'}"/><filter name="group_date" string="Issue Date" context="{'group_by':'issue_date'}"/></group></search></field></record>
  <record id="action_fusion_travel_flight_ticket" model="ir.actions.act_window"><field name="name">Flight Tickets</field><field name="res_model">fusion.travel.flight.ticket</field><field name="view_mode">list,form,pivot,graph</field><field name="view_id" ref="view_flight_ticket_tree"/><field name="search_view_id" ref="view_flight_ticket_search"/><field name="context">{}</field></record>
</odoo>
