<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_fusion_travel_airline_list" model="ir.ui.view">
    <field name="name">fusion.travel.airline.list</field><field name="model">fusion.travel.airline</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="iata_code"/><field name="accounting_code"/><field name="icao_code"/><field name="active"/></list></field>
  </record>
  <record id="view_fusion_travel_airline_form" model="ir.ui.view">
    <field name="name">fusion.travel.airline.form</field><field name="model">fusion.travel.airline</field>
    <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="iata_code"/><field name="accounting_code"/><field name="icao_code"/><field name="website"/><field name="active"/></group></sheet></form></field>
  </record>
  <record id="action_fusion_travel_airlines" model="ir.actions.act_window"><field name="name">Airlines</field><field name="res_model">fusion.travel.airline</field><field name="view_mode">list,form</field></record>
</odoo>
