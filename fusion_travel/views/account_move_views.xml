<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_move_form_fusion_travel_inherit" model="ir.ui.view">
    <field name="name">account.move.form.fusion.travel.inherit</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_flight_tickets" type="object" class="oe_stat_button" icon="fa-plane" invisible="not flight_ticket_ids">
          <field name="flight_ticket_ids" widget="statinfo" string="Flight Tickets"/>
        </button>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Travel" invisible="not fusion_travel_booking_ids and not flight_ticket_ids and not fusion_travel_ticket_invoice_ids">
          <field name="fusion_travel_booking_ids" readonly="1"/>
          <field name="flight_ticket_ids" readonly="1"/>
          <field name="fusion_travel_ticket_invoice_ids" readonly="1"/>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
