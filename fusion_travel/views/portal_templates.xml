<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_my_home_menu_travel" inherit_id="portal.portal_my_home" priority="35"><xpath expr="//div[hasclass('o_portal_docs')]" position="inside"><t t-call="portal.portal_docs_entry"><t t-set="title">Travel Bookings</t><t t-set="url" t-value="'/my/travel/bookings'"/><t t-set="placeholder_count" t-value="'fusion_travel_booking_count'"/></t></xpath></template>
  <template id="portal_my_trip_bookings" name="My Travel Bookings"><t t-call="portal.portal_layout"><t t-set="breadcrumbs_searchbar" t-value="True"/><t t-call="portal.portal_searchbar"><t t-set="title">Travel Bookings</t></t><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Booking</th><th>Service</th><th>Status</th><th>Payment</th><th>Total</th></tr></thead><tbody><t t-foreach="bookings" t-as="booking"><tr><td><a t-att-href="'/my/travel/booking/%s' % booking.id" t-out="booking.name"/></td><td t-out="booking.booking_type.title()"/><td t-out="booking.state"/><td t-out="booking.payment_status"/><td><t t-out="booking.total_amount"/> <t t-out="booking.currency_id.name"/></td></tr></t></tbody></table></div></t></template>
  <template id="portal_my_trip_booking_detail" name="Travel Booking Detail"><t t-call="portal.portal_layout"><h2 t-out="booking.name"/><div class="row"><div class="col-lg-8"><div class="card"><div class="card-body"><p><b>Service:</b> <t t-out="booking.booking_type"/></p><p><b>Status:</b> <t t-out="booking.state"/></p><p><b>PNR:</b> <t t-out="booking.pnr or '-'"/></p><p><b>Provider reference:</b> <t t-out="booking.amadeus_reference or '-'"/></p><p><b>Total:</b> <t t-out="booking.total_amount"/> <t t-out="booking.currency_id.name"/></p></div></div></div><div class="col-lg-4"><t t-if="booking.invoice_id"><a class="btn btn-primary" t-att-href="'/my/invoices/%s' % booking.invoice_id.id">View Invoice</a></t></div></div></t></template>
</odoo>
