<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="fusion_travel_frontend_layout" name="Fusion Travel Frontend Layout">
    <t t-call="website.layout">
      <div id="wrap" class="ft-site">
        <header class="ft-header">
          <a href="/travel" class="ft-logo" aria-label="Fusion Travel home"><span class="ft-logo-mark">F</span><span><strong>FUSION</strong><small>TRAVEL</small></span></a>
          <nav class="ft-nav" aria-label="Travel services">
            <a href="/travel/flights" t-att-class="'active' if service == 'flight' else ''">Flights</a>
            <a href="/travel/hotels" t-att-class="'active' if service == 'hotel' else ''">Hotels</a>
            <a href="/travel/cars" t-att-class="'active' if service == 'car' else ''">Cars</a>
            <a href="#">Holidays</a><a href="#">Deals</a>
          </nav>
          <div class="ft-header-actions"><span class="ft-chip">English</span><span class="ft-chip">USD</span><a class="ft-btn ft-btn-primary ft-btn-sm" href="/my/travel/bookings">My Portal</a></div>
        </header>
        <main><t t-out="0"/></main>
      </div>
    </t>
  </template>

  <template id="trip_booking_steps" name="Fusion Travel Booking Steps">
    <ol class="ft-steps">
      <li t-att-class="'active' if current_step == 1 else ('done' if current_step &gt; 1 else '')"><span>1</span>Search</li>
      <li t-att-class="'active' if current_step == 2 else ('done' if current_step &gt; 2 else '')"><span>2</span>Select</li>
      <li t-att-class="'active' if current_step == 3 else ('done' if current_step &gt; 3 else '')"><span>3</span>Travelers</li>
      <li t-att-class="'active' if current_step == 4 else ('done' if current_step &gt; 4 else '')"><span>4</span>Price</li>
      <li t-att-class="'active' if current_step == 5 else ('done' if current_step &gt; 5 else '')"><span>5</span>Payment</li>
      <li t-att-class="'active' if current_step == 6 else ''"><span>6</span>Confirmation</li>
    </ol>
  </template>

  <template id="trip_services_nav" name="Fusion Travel Service Tabs">
    <div class="ft-service-tabs"><a href="/travel/flights" t-att-class="'active' if service == 'flight' else ''">Flights</a><a href="/travel/hotels" t-att-class="'active' if service == 'hotel' else ''">Hotels</a><a href="/travel/cars" t-att-class="'active' if service == 'car' else ''">Cars</a><a href="#">Deals</a></div>
  </template>

  <template id="flights_search_template" name="Fusion Travel Flight Search">
    <t t-set="service" t-value="'flight'"/><t t-call="fusion_travel.fusion_travel_frontend_layout">
      <section class="ft-hero ft-container"><div class="ft-hero-copy"><span class="ft-eyebrow">LIVE FARES</span><h1>Search flights.<br/>Choose the fare that fits.</h1><p>Compare total prices, baggage, seats, changes and refunds before you book — all in one clear journey.</p></div><div class="ft-hero-visual"><strong>Live availability across hundreds of airlines</strong><span class="ft-plane">✈</span><div class="ft-route-line">● ─── ● ─── ● ─── ●</div></div></section>
      <section class="ft-container ft-search-shell"><t t-set="service" t-value="'flight'"/><t t-call="fusion_travel.trip_services_nav"/>
        <form action="/travel/flights/search" method="post" class="ft-search-form" data-ft-search-form="flight">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <div class="ft-trip-types"><label><input type="radio" name="trip_type" value="round" checked="checked"/>Round trip</label><label><input type="radio" name="trip_type" value="oneway"/>One way</label><label><input type="radio" name="trip_type" value="multi"/>Multi-city</label></div>
          <label><span>FROM</span><input name="origin" value="JFK" maxlength="3" placeholder="New York · JFK" required="required"/></label>
          <label><span>TO</span><input name="destination" value="CDG" maxlength="3" placeholder="Paris · CDG" required="required"/></label>
          <label><span>DEPART</span><input type="date" name="departure_date" required="required"/></label>
          <label data-ft-return=""><span>RETURN</span><input type="date" name="return_date"/></label>
          <label><span>TRAVELERS &amp; CLASS</span><div class="ft-inline-fields"><input type="number" name="adults" value="1" min="1" max="9" aria-label="Adults"/><select name="travel_class"><option value="ECONOMY">Economy</option><option value="PREMIUM_ECONOMY">Premium Economy</option><option value="BUSINESS">Business</option><option value="FIRST">First</option></select></div><input type="hidden" name="children" value="0"/><input type="hidden" name="infants" value="0"/><input type="hidden" name="currency" value="USD"/></label>
          <button class="ft-btn ft-btn-primary" type="submit">Search flights</button>
          <div class="ft-search-options"><label><input type="checkbox" name="non_stop" value="1"/> Direct flights</label><label><input type="checkbox" name="nearby_airports" value="1"/> Nearby airports</label><label><input type="checkbox" name="flexible_dates" value="1"/> Flexible dates ±3 days</label><label><input type="checkbox" name="show_total" value="1" checked="checked"/> Show total price</label></div>
        </form>
      </section>
      <section class="ft-benefits"><div><b>◎</b><span><strong>Live availability</strong><small>Up-to-date fares and seats</small></span></div><div><b>↓</b><span><strong>Total price first</strong><small>Taxes and fees shown upfront</small></span></div><div><b>≡</b><span><strong>Fare choices</strong><small>Basic, Standard and Flex</small></span></div><div><b>✓</b><span><strong>Secure booking</strong><small>Support through ticketing</small></span></div></section>
      <section class="ft-container ft-destinations"><div class="ft-section-heading"><div><span>POPULAR DESTINATIONS</span><h2>Trips worth planning</h2></div><a class="ft-btn ft-btn-secondary" href="#">View all destinations</a></div><div class="ft-card-grid"><t t-foreach="[('DUBAI','United Arab Emirates','199','50% OFF'),('ISTANBUL','Türkiye','179','POPULAR'),('PARIS','France','249','TOP PICK'),('MALDIVES','Maldives','499','POPULAR')]" t-as="dest"><article class="ft-destination-card"><em t-out="dest[3]"/><h3 t-out="dest[0]"/><p t-out="dest[1]"/><div><span>from <strong>$<t t-out="dest[2]"/></strong></span><a href="/travel/flights">→</a></div></article></t></div></section>
      <section class="ft-container ft-trust"><div><b>300+</b><small>Airlines</small></div><div><b>1M+</b><small>Hotels</small></div><div><b>200+</b><small>Countries</small></div><div><b>24/7</b><small>Support</small></div><div><b>100%</b><small>Secure payments</small></div></section>
    </t>
  </template>

  <template id="trip_search_results_template" name="Fusion Travel Flight Results">
    <t t-set="service" t-value="'flight'"/><t t-call="fusion_travel.fusion_travel_frontend_layout"><section class="ft-results-head"><div class="ft-container"><h1><t t-out="search.get('origin','From')"/> → <t t-out="search.get('destination','To')"/></h1><p><t t-out="search.get('departure_date','')"/> <t t-if="search.get('return_date')">– <t t-out="search.get('return_date')"/></t> · <t t-out="search.get('adults',1)"/> Adult · <t t-out="search.get('travel_class') or 'Economy'"/></p><a class="ft-btn ft-btn-primary" href="/travel/flights">Search again</a></div></section><section class="ft-container ft-results-layout"><aside class="ft-filters"><h2>Filters</h2><h3>Stops</h3><label><input type="checkbox"/> Nonstop</label><label><input type="checkbox"/> 1 stop or less</label><h3>Departure time</h3><div class="ft-filter-pills"><button>Morning</button><button>Afternoon</button><button>Evening</button></div><h3>Baggage &amp; fare</h3><label><input type="checkbox"/> Checked bag included</label><label><input type="checkbox"/> Refundable</label><label><input type="checkbox"/> Free changes</label></aside><div class="ft-results"><div class="ft-section-heading"><div><h2>Flight results</h2><p>Lowest total price shown for each complete itinerary</p></div></div>
      <t t-if="error"><div class="ft-alert ft-alert-warning"><strong>Search could not be completed.</strong><span t-out="error"/></div></t>
      <t t-if="offers"><t t-foreach="offers" t-as="offer"><t t-set="price" t-value="offer.get('price') or {}"/><t t-set="itinerary" t-value="(offer.get('itineraries') or [{}])[0]"/><t t-set="segments" t-value="itinerary.get('segments') or []"/><t t-set="first" t-value="segments[0] if segments else {}"/><article class="ft-offer-card"><div class="ft-offer-main"><div class="ft-airline"><span><t t-out="first.get('carrierCode') or 'AIR'"/></span><div><h3>Airline <t t-out="first.get('carrierCode') or ''"/></h3><p><t t-out="first.get('carrierCode') or ''"/> <t t-out="first.get('number') or ''"/> · <t t-out="search.get('travel_class') or 'Economy'"/></p></div></div><div class="ft-itinerary"><t t-foreach="segments" t-as="segment"><div class="ft-segment"><span class="ft-segment-label">SEGMENT <t t-out="segment_index + 1"/></span><strong><t t-out="(segment.get('departure') or {}).get('at','')[11:16]"/></strong><small><t t-out="(segment.get('departure') or {}).get('iataCode')"/></small><i>→</i><strong><t t-out="(segment.get('arrival') or {}).get('at','')[11:16]"/></strong><small><t t-out="(segment.get('arrival') or {}).get('iataCode')"/></small></div></t></div><div class="ft-tags"><span><t t-out="(len(segments) - 1) if len(segments) > 1 else 0"/> stop(s)</span><span>Cabin bag</span><span>Taxes included</span></div></div><div class="ft-offer-price"><small>FROM</small><strong><t t-out="price.get('currency')"/> <t t-out="price.get('grandTotal') or price.get('total')"/></strong><p>total · taxes included</p><form action="/travel/flights/book" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="offer_token" t-att-value="offer.get('_token')"/><button class="ft-btn ft-btn-primary">Book now</button></form></div></article></t></t><t t-elif="not error"><div class="ft-empty">No flight offers returned for this search.</div></t></div></section></t>
  </template>

  <template id="trip_passenger_details_template" name="Fusion Travel Traveler Details">
    <t t-set="service" t-value="booking.booking_type"/><t t-call="fusion_travel.fusion_travel_frontend_layout"><section class="ft-container ft-flow-page"><t t-set="current_step" t-value="3"/><t t-call="fusion_travel.trip_booking_steps"/><div class="ft-flow-grid"><div><span class="ft-eyebrow">TRAVELER DETAILS</span><h1>Who is traveling?</h1><p>Enter names exactly as shown on the travel document.</p><t t-if="error"><div class="ft-alert ft-alert-warning" t-out="error"/></t><form t-att-action="'/travel/booking/%s/passengers' % booking.id" method="post" class="ft-panel ft-traveler-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><t t-foreach="traveler_types" t-as="ptype"><t t-set="idx" t-value="ptype_index"/><fieldset><legend>Traveler <t t-out="idx + 1"/> · <t t-out="ptype.title()"/></legend><div class="ft-form-grid"><label><span>FIRST NAME</span><input t-att-name="'first_name_%s' % idx" required="required"/></label><label><span>LAST NAME</span><input t-att-name="'last_name_%s' % idx" required="required"/></label><label><span>DATE OF BIRTH</span><input type="date" t-att-name="'date_of_birth_%s' % idx" t-att-required="booking.booking_type == 'flight'"/></label><label><span>GENDER</span><select t-att-name="'gender_%s' % idx"><option value="male">Male</option><option value="female">Female</option></select></label><label><span>NATIONALITY</span><input t-att-name="'nationality_%s' % idx" placeholder="US" maxlength="2"/></label><label><span>PASSPORT NUMBER</span><input t-att-name="'passport_number_%s' % idx"/></label><label><span>PASSPORT EXPIRY</span><input type="date" t-att-name="'passport_expiry_%s' % idx"/></label><label><span>EMAIL</span><input type="email" t-att-name="'email_%s' % idx" t-att-value="request.env.user.email or ''"/></label><label><span>PHONE</span><input t-att-name="'phone_%s' % idx" t-att-value="request.env.user.partner_id.phone or request.env.user.partner_id.mobile or ''" t-att-required="booking.booking_type == 'flight'"/></label></div></fieldset></t><button class="ft-btn ft-btn-primary" type="submit">Continue to price check</button></form></div><aside class="ft-summary"><h2>Booking summary</h2><p><strong t-out="booking.name"/></p><p>Service <span t-out="booking.booking_type.title()"/></p><p>Total <strong><t t-out="booking.total_amount"/> <t t-out="booking.currency_id.name"/></strong></p></aside></div></section></t>
  </template>

  <template id="trip_price_confirmation_template" name="Fusion Travel Price Confirmation">
    <t t-set="service" t-value="booking.booking_type"/><t t-call="fusion_travel.fusion_travel_frontend_layout"><section class="ft-container ft-flow-page"><t t-set="current_step" t-value="4"/><t t-call="fusion_travel.trip_booking_steps"/><div class="ft-flow-grid"><div><span class="ft-eyebrow">LIVE PRICE CHECK</span><h1>Confirm the latest price</h1><p>Supplier availability and total price are checked again before payment.</p><t t-if="error"><div class="ft-alert ft-alert-warning" t-out="error"/></t><div class="ft-panel"><div class="ft-price-row"><span>Provider net</span><strong><t t-out="booking.net_amount"/> <t t-out="booking.currency_id.name"/></strong></div><div class="ft-price-row"><span>Fusion service / markup</span><strong><t t-out="booking.markup_amount"/> <t t-out="booking.currency_id.name"/></strong></div><div class="ft-price-row total"><span>Total</span><strong><t t-out="booking.total_amount"/> <t t-out="booking.currency_id.name"/></strong></div><form t-att-action="'/travel/booking/%s/confirm-price' % booking.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="ft-btn ft-btn-primary">Revalidate and continue</button></form></div></div><aside class="ft-summary"><h2>Price protection</h2><p>The selected provider offer is stored server-side and cannot be edited in the browser.</p><p>Expired or changed offers require explicit customer confirmation.</p></aside></div></section></t>
  </template>

  <template id="trip_payment_template" name="Fusion Travel Payment">
    <t t-set="service" t-value="booking.booking_type"/><t t-call="fusion_travel.fusion_travel_frontend_layout"><section class="ft-container ft-flow-page"><t t-set="current_step" t-value="5"/><t t-call="fusion_travel.trip_booking_steps"/><div class="ft-flow-grid"><div><span class="ft-eyebrow">SECURE PAYMENT</span><h1>Choose how to pay</h1><p>The wallet balance is checked under a transaction lock and charged only after a successful supplier booking.</p><t t-if="error"><div class="ft-alert ft-alert-warning" t-out="error"/></t><form t-att-action="'/travel/booking/%s/payment' % booking.id" method="post" class="ft-panel ft-payment-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label class="ft-payment-option"><input type="radio" name="payment_method" value="wallet" checked="checked"/><span><b>Fusion Wallet</b><small>Use available Odoo wallet balance</small></span></label><label class="ft-payment-option"><input type="radio" name="payment_method" value="amadeus_card"/><span><b>Card / Provider payment</b><small>Redirect to a hosted PCI-compliant provider; raw card data is never stored in Odoo</small></span></label><button class="ft-btn ft-btn-primary">Continue booking</button></form></div><aside class="ft-summary"><h2>Amount due</h2><strong class="ft-big-total"><t t-out="booking.total_amount"/> <t t-out="booking.currency_id.name"/></strong><p>Taxes and Fusion fees included.</p></aside></div></section></t>
  </template>

  <template id="trip_issue_template" name="Fusion Travel Confirmation">
    <t t-set="service" t-value="booking.booking_type"/><t t-call="fusion_travel.fusion_travel_frontend_layout"><section class="ft-container ft-flow-page"><t t-set="current_step" t-value="6"/><t t-call="fusion_travel.trip_booking_steps"/><div class="ft-confirmation"><span class="ft-success-icon">✓</span><span class="ft-eyebrow">BOOKING READY</span><h1>Booking status</h1><p>Booking <strong t-out="booking.name"/> · Current state <strong t-out="booking.state"/></p><t t-if="error"><div class="ft-alert ft-alert-warning" t-out="error"/></t><div class="ft-panel"><p><b>Provider reference:</b> <t t-out="booking.amadeus_reference or 'Pending'"/></p><p><b>PNR:</b> <t t-out="booking.pnr or 'Pending'"/></p><p><b>Payment:</b> <t t-out="booking.payment_status"/></p><t t-if="booking.payment_status == 'paid' and not booking.amadeus_reference"><form t-att-action="'/travel/booking/%s/issue' % booking.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="ft-btn ft-btn-primary">Create supplier order</button></form></t><t t-elif="booking.payment_status != 'paid'"><p>Waiting for a verified payment confirmation.</p></t></div><a href="/my/travel/bookings" class="ft-btn ft-btn-secondary">View My Portal</a></div></section></t>
  </template>

  <template id="hotels_search_template" name="Fusion Travel Hotel Search">
    <t t-set="service" t-value="'hotel'"/><t t-call="fusion_travel.fusion_travel_frontend_layout"><section class="ft-hero ft-container"><div class="ft-hero-copy"><span class="ft-eyebrow">LIVE HOTEL RATES</span><h1>Find the right stay.</h1><p>Compare rooms, cancellation terms and total prices before booking.</p></div><div class="ft-hero-visual"><strong>Hotels in destinations worldwide</strong><span class="ft-plane">⌂</span></div></section><section class="ft-container ft-search-shell"><t t-call="fusion_travel.trip_services_nav"/><form action="/travel/hotels/search" method="post" class="ft-search-form ft-search-form-hotel"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label><span>DESTINATION</span><input name="city_code" value="PAR" maxlength="3" required="required" placeholder="Paris · PAR"/></label><label><span>CHECK-IN</span><input type="date" name="checkin_date" required="required"/></label><label><span>CHECK-OUT</span><input type="date" name="checkout_date" required="required"/></label><label><span>GUESTS</span><input type="number" name="adults" value="1" min="1" max="9"/></label><label><span>ROOMS</span><input type="number" name="room_quantity" value="1" min="1" max="9"/></label><input type="hidden" name="currency" value="USD"/><button class="ft-btn ft-btn-primary">Search hotels</button></form></section></t>
  </template>

  <template id="trip_hotel_results_template" name="Fusion Travel Hotel Results">
    <t t-set="service" t-value="'hotel'"/><t t-call="fusion_travel.fusion_travel_frontend_layout"><section class="ft-container ft-flow-page"><span class="ft-eyebrow">HOTEL RESULTS</span><h1>Stays in <t t-out="search.get('city_code') or 'your destination'"/></h1><t t-if="error"><div class="ft-alert ft-alert-warning" t-out="error"/></t><div class="ft-hotel-grid"><t t-foreach="hotels" t-as="item"><t t-set="hotel" t-value="item.get('hotel') or {}"/><t t-set="offer" t-value="item.get('offer') or {}"/><t t-set="price" t-value="offer.get('price') or {}"/><article class="ft-hotel-card"><div class="ft-hotel-image">HOTEL</div><div class="ft-hotel-content"><h2 t-out="hotel.get('name') or 'Hotel'"/><p><t t-out="hotel.get('cityCode') or ''"/> · <t t-out="(offer.get('room') or {}).get('typeEstimated',{}).get('category','Room')"/></p><div class="ft-price-row total"><span>Total</span><strong><t t-out="price.get('currency')"/> <t t-out="price.get('total')"/></strong></div><form action="/travel/hotels/book" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="offer_token" t-att-value="item.get('_token')"/><button class="ft-btn ft-btn-primary">Select room</button></form></div></article></t><t t-if="not hotels and not error"><div class="ft-empty">No hotel offers returned.</div></t></div></section></t>
  </template>

  <template id="cars_search_template" name="Fusion Travel Cars and Transfers Search">
    <t t-set="service" t-value="'car'"/><t t-call="fusion_travel.fusion_travel_frontend_layout"><section class="ft-hero ft-container"><div class="ft-hero-copy"><span class="ft-eyebrow">CARS &amp; AIRPORT TRANSFERS</span><h1>Move on your schedule.</h1><p>Search airport transfers now. A true self-drive rental provider adapter can use the same Odoo booking model.</p></div><div class="ft-hero-visual"><strong>Private transfer and vehicle services</strong><span class="ft-plane">▰</span></div></section><section class="ft-container ft-search-shell"><t t-call="fusion_travel.trip_services_nav"/><form action="/travel/cars/search" method="post" class="ft-search-form ft-search-form-car"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label><span>PICKUP AIRPORT</span><input name="pickup_location" value="CDG" maxlength="3" required="required"/></label><label><span>PICKUP DATE &amp; TIME</span><input type="datetime-local" name="pickup_datetime" required="required"/></label><label><span>DROP-OFF ADDRESS</span><input name="dropoff_address" placeholder="Address" required="required"/></label><label><span>CITY</span><input name="dropoff_city" placeholder="Paris" required="required"/></label><label><span>COUNTRY</span><input name="dropoff_country_code" value="FR" maxlength="2" required="required"/></label><input type="hidden" name="dropoff_zip"/><input type="hidden" name="passengers" value="1"/><input type="hidden" name="transfer_type" value="PRIVATE"/><button class="ft-btn ft-btn-primary">Search vehicles</button></form></section></t>
  </template>

  <template id="trip_car_results_template" name="Fusion Travel Car and Transfer Results">
    <t t-set="service" t-value="'car'"/><t t-call="fusion_travel.fusion_travel_frontend_layout"><section class="ft-container ft-flow-page"><span class="ft-eyebrow">VEHICLE RESULTS</span><h1>Available transfer options</h1><t t-if="error"><div class="ft-alert ft-alert-warning" t-out="error"/></t><div class="ft-hotel-grid"><t t-foreach="offers" t-as="offer"><t t-set="vehicle" t-value="offer.get('vehicle') or {}"/><t t-set="quote" t-value="offer.get('quotation') or {}"/><article class="ft-hotel-card"><div class="ft-hotel-image">CAR</div><div class="ft-hotel-content"><h2 t-out="vehicle.get('description') or vehicle.get('code') or 'Vehicle'"/><p t-out="(offer.get('serviceProvider') or {}).get('name') or 'Transfer provider'"/><div class="ft-price-row total"><span>Total</span><strong><t t-out="quote.get('currencyCode')"/> <t t-out="quote.get('monetaryAmount')"/></strong></div><form action="/travel/cars/book" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="offer_token" t-att-value="offer.get('_token')"/><button class="ft-btn ft-btn-primary">Choose vehicle</button></form></div></article></t><t t-if="not offers and not error"><div class="ft-empty">No vehicle offers returned.</div></t></div></section></t>
  </template>

  <template id="trip_booking_error_template" name="Fusion Travel Booking Error"><t t-set="service" t-value="'flight'"/><t t-call="fusion_travel.fusion_travel_frontend_layout"><section class="ft-container ft-flow-page"><div class="ft-alert ft-alert-danger"><strong>We could not continue this booking.</strong><span t-out="error"/></div><a class="ft-btn ft-btn-primary" href="/travel">Start a new search</a></section></t></template>
</odoo>
