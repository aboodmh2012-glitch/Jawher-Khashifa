{
  "realm": "fusion",
  "enabled": true,
  "displayName": "Fusion Operations Platform",
  "roles": {
    "realm": [
      {
        "name": "platform-admin"
      },
      {
        "name": "org-admin"
      },
      {
        "name": "ops-supervisor"
      },
      {
        "name": "operator"
      },
      {
        "name": "analyst"
      },
      {
        "name": "field-user"
      },
      {
        "name": "viewer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "fusion-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:5173/"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "fusion-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "orgId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "orgId",
            "claim.name": "orgId",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "role",
            "claim.name": "role",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
