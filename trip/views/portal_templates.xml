<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_trip" name="Trip Portal Entry" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Trip Bookings</t>
                <t t-set="url" t-value="'/my/trip/bookings'"/>
                <t t-set="placeholder_count" t-value="'trip_booking_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_trip_bookings" name="My Trip Bookings">
        <t t-call="portal.portal_layout">
            <div class="container">
                <h3>My Bookings</h3>
                <table class="table table-striped">
                    <thead>
                        <tr><th>Booking</th><th>Type</th><th>Status</th><th>Total</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="bookings" t-as="booking">
                            <td><a t-att-href="'/my/trip/booking/%s' % booking.id"><t t-out="booking.name"/></a></td>
                            <td><t t-out="booking.booking_type"/></td>
                            <td><t t-out="booking.state"/></td>
                            <td><t t-out="booking.total_amount"/> <t t-out="booking.currency_id.name"/></td>
                        </tr>
                    </tbody>
                </table>
                <t t-if="pager" t-call="portal.pager"/>
            </div>
        </t>
    </template>

    <template id="portal_my_trip_booking_detail" name="Trip Booking Detail">
        <t t-call="portal.portal_layout">
            <div class="container">
                <h3><t t-out="booking.name"/></h3>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Type:</strong> <t t-out="booking.booking_type"/></p>
                        <p><strong>Status:</strong> <t t-out="booking.state"/></p>
                        <p><strong>Payment:</strong> <t t-out="booking.payment_status"/></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>PNR:</strong> <t t-out="booking.pnr or '-'"/></p>
                        <p><strong>Total:</strong> <t t-out="booking.total_amount"/> <t t-out="booking.currency_id.name"/></p>
                    </div>
                </div>
                <t t-if="booking.flight_segment_ids">
                    <h5>Flights</h5>
                    <table class="table table-sm">
                        <thead><tr><th>Airline</th><th>Flight</th><th>From</th><th>To</th><th>Departure</th><th>Arrival</th></tr></thead>
                        <tbody>
                            <tr t-foreach="booking.flight_segment_ids" t-as="seg">
                                <td><t t-out="seg.airline_code or seg.airline or ''"/></td>
                                <td><t t-out="seg.flight_number or ''"/></td>
                                <td><t t-out="seg.origin_airport or ''"/></td>
                                <td><t t-out="seg.destination_airport or ''"/></td>
                                <td><t t-out="seg.departure_time or ''"/></td>
                                <td><t t-out="seg.arrival_time or ''"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <a href="/my/trip/bookings" class="btn btn-secondary">Back to bookings</a>
            </div>
        </t>
    </template>
</odoo>
