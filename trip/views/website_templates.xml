<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="trip_booking_steps" name="Trip Booking Steps">
        <div class="d-flex gap-2 flex-wrap mb-4 small">
            <span class="badge text-bg-secondary">1 Search</span>
            <span class="badge text-bg-secondary">2 Select</span>
            <span class="badge text-bg-secondary">3 Passengers</span>
            <span class="badge text-bg-secondary">4 Price</span>
            <span class="badge text-bg-secondary">5 Payment</span>
            <span class="badge text-bg-secondary">6 Issue</span>
        </div>
    </template>

    <template id="flights_search_template" name="Trip Flights Search">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1>Flights</h1>
                <t t-call="trip.trip_services_nav"/>
                <t t-call="trip.trip_booking_steps"/>
                <form action="/trip/flights/search" method="post" class="row g-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="col-md-2"><input class="form-control" name="origin" placeholder="From / Airport Code" required="required"/></div>
                    <div class="col-md-2"><input class="form-control" name="destination" placeholder="To / Airport Code" required="required"/></div>
                    <div class="col-md-2"><input class="form-control" type="date" name="departure_date" required="required"/></div>
                    <div class="col-md-2"><input class="form-control" type="date" name="return_date"/></div>
                    <div class="col-md-1"><input class="form-control" type="number" name="adults" value="1" min="1"/></div>
                    <div class="col-md-1"><input class="form-control" type="number" name="children" value="0" min="0"/></div>
                    <div class="col-md-1"><input class="form-control" type="number" name="infants" value="0" min="0"/></div>
                    <div class="col-md-1">
                        <select class="form-select" name="travel_class">
                            <option value="">Any</option>
                            <option value="ECONOMY">Economy</option>
                            <option value="PREMIUM_ECONOMY">Premium</option>
                            <option value="BUSINESS">Business</option>
                            <option value="FIRST">First</option>
                        </select>
                    </div>
                    <div class="col-md-2"><input class="form-control" name="currency" placeholder="Currency" value="USD"/></div>
                    <div class="col-md-2"><button class="btn btn-primary w-100">Search</button></div>
                </form>
            </div>
        </t>
    </template>

    <template id="trip_search_results_template" name="Trip Search Results">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1>Search Results</h1>
                <t t-call="trip.trip_booking_steps"/>
                <t t-if="error">
                    <div class="alert alert-warning">
                        Search could not be completed. Check Trip API settings in Odoo.
                        <div class="small mt-1"><t t-out="error"/></div>
                    </div>
                </t>
                <t t-if="offers">
                    <div class="row g-3">
                        <t t-foreach="offers[:10]" t-as="offer">
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title">Offer <t t-out="offer.get('id')"/></h5>
                                        <p class="mb-1">
                                            <strong>Total:</strong>
                                            <t t-out="offer.get('price', {}).get('grandTotal') or offer.get('price', {}).get('total')"/>
                                            <t t-out="offer.get('price', {}).get('currency')"/>
                                        </p>
                                        <p class="text-muted small mb-2">
                                            Stops and baggage depend on supplier response. Price will be revalidated before payment.
                                        </p>
                                        <form action="/trip/flights/book" method="post" class="mt-3">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="offer_payload" t-att-value="offer.get('_payload')"/>
                                            <button type="submit" class="btn btn-primary btn-sm">Book this offer</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-if="not offers and not error">
                    <p>No offers returned for this search.</p>
                </t>
            </div>
        </t>
    </template>

    <template id="trip_passenger_details_template" name="Trip Passenger Details">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1>Passenger Details</h1>
                <t t-call="trip.trip_booking_steps"/>
                <t t-if="error"><div class="alert alert-warning"><t t-out="error"/></div></t>
                <form t-att-action="'/trip/booking/%s/passengers' % booking.id" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <t t-foreach="traveler_types" t-as="ptype">
                        <t t-set="idx" t-value="ptype_index"/>
                        <div class="card mb-3">
                            <div class="card-header">
                                Passenger <t t-out="idx + 1"/> — <t t-out="ptype.title()"/>
                            </div>
                            <div class="card-body row g-3">
                                <div class="col-md-3"><label class="form-label">First Name</label><input class="form-control" t-att-name="'first_name_%s' % idx" required="required"/></div>
                                <div class="col-md-3"><label class="form-label">Last Name</label><input class="form-control" t-att-name="'last_name_%s' % idx" required="required"/></div>
                                <div class="col-md-2"><label class="form-label">Date of Birth</label><input class="form-control" type="date" t-att-name="'date_of_birth_%s' % idx"/></div>
                                <div class="col-md-2">
                                    <label class="form-label">Gender</label>
                                    <select class="form-select" t-att-name="'gender_%s' % idx">
                                        <option value="male">Male</option>
                                        <option value="female">Female</option>
                                    </select>
                                </div>
                                <div class="col-md-2"><label class="form-label">Nationality Code</label><input class="form-control" t-att-name="'nationality_%s' % idx" placeholder="US"/></div>
                                <div class="col-md-3"><label class="form-label">Passport Number</label><input class="form-control" t-att-name="'passport_number_%s' % idx"/></div>
                                <div class="col-md-3"><label class="form-label">Passport Expiry</label><input class="form-control" type="date" t-att-name="'passport_expiry_%s' % idx"/></div>
                                <div class="col-md-3"><label class="form-label">Email</label><input class="form-control" type="email" t-att-name="'email_%s' % idx" t-att-value="request.env.user.email or ''"/></div>
                                <div class="col-md-3"><label class="form-label">Phone</label><input class="form-control" t-att-name="'phone_%s' % idx" t-att-value="request.env.user.partner_id.phone or request.env.user.partner_id.mobile or ''"/></div>
                            </div>
                        </div>
                    </t>
                    <button class="btn btn-primary">Continue to price confirmation</button>
                </form>
            </div>
        </t>
    </template>

    <template id="trip_price_confirmation_template" name="Trip Price Confirmation">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1>Price Confirmation</h1>
                <t t-call="trip.trip_booking_steps"/>
                <t t-if="error"><div class="alert alert-warning"><t t-out="error"/></div></t>
                <div class="card mb-3">
                    <div class="card-body">
                        <p><strong>Booking:</strong> <t t-out="booking.name"/></p>
                        <p><strong>Current Total:</strong> <t t-out="booking.total_amount"/> <t t-out="booking.currency_id.name"/></p>
                        <p class="text-muted">The supplier price must be revalidated before payment and order creation.</p>
                    </div>
                </div>
                <form t-att-action="'/trip/booking/%s/confirm-price' % booking.id" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button class="btn btn-primary">Revalidate price</button>
                </form>
            </div>
        </t>
    </template>

    <template id="trip_payment_template" name="Trip Payment">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1>Choose Payment</h1>
                <t t-call="trip.trip_booking_steps"/>
                <t t-if="error"><div class="alert alert-warning"><t t-out="error"/></div></t>
                <div class="card mb-3">
                    <div class="card-body">
                        <p><strong>Total:</strong> <t t-out="booking.total_amount"/> <t t-out="booking.currency_id.name"/></p>
                        <p class="text-muted mb-0">
                            Choose only one payment method: external provider/card flow or Odoo wallet balance.
                            External provider/card flow creates a supplier PNR/order only; payment and ticketing must be completed by your consolidator/ARC/IATA/Enterprise adapter. Wallet checks balance first; after successful supplier booking, it deducts wallet balance and creates/posts the Odoo invoice for accounting.
                        </p>
                    </div>
                </div>
                <form t-att-action="'/trip/booking/%s/payment' % booking.id" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="mb-3">
                        <label class="form-label">Payment Method</label>
                        <select class="form-select" name="payment_method" id="trip_payment_method">
                            <option value="amadeus_card">External Provider/Card Flow</option>
                            <option value="wallet">Odoo Wallet Balance</option>
                        </select>
                    </div>

                    <div id="trip_card_notice" class="alert alert-info mb-3">
                        For PCI safety, this Odoo module does not collect raw card numbers. Use a hosted payment page or a tokenized Enterprise/NDC adapter for real card charging.
                    </div>

                    <button class="btn btn-primary">Continue Booking</button>
                </form>
            </div>
        </t>
    </template>

    <template id="trip_issue_template" name="Trip Issue">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1>Issue Booking</h1>
                <t t-call="trip.trip_booking_steps"/>
                <t t-if="error"><div class="alert alert-warning"><t t-out="error"/></div></t>
                <div class="card mb-3">
                    <div class="card-body">
                        <p><strong>Booking:</strong> <t t-out="booking.name"/></p>
                        <p><strong>Status:</strong> <t t-out="booking.state"/></p>
                        <p><strong>Payment:</strong> <t t-out="booking.payment_status"/></p>
                        <p class="text-muted">This will create the supplier order through the configured Amadeus Enterprise / Aggregator connector.</p>
                    </div>
                </div>
                <form t-att-action="'/trip/booking/%s/issue' % booking.id" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button class="btn btn-success">Create supplier order</button>
                </form>
            </div>
        </t>
    </template>

    <template id="trip_services_nav" name="Trip Services Nav">
        <div class="d-flex gap-2 mb-3">
            <a href="/trip/flights" class="btn btn-outline-primary btn-sm">Flights</a>
            <a href="/trip/hotels" class="btn btn-outline-primary btn-sm">Hotels</a>
            <a href="/trip/cars" class="btn btn-outline-primary btn-sm">Transfers / Cars</a>
        </div>
    </template>

    <template id="hotels_search_template" name="Trip Hotels Search">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1>Hotels</h1>
                <t t-call="trip.trip_services_nav"/>
                <t t-call="trip.trip_booking_steps"/>
                <form action="/trip/hotels/search" method="post" class="row g-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="col-md-2"><input class="form-control" name="city_code" placeholder="City Code (PAR)" required="required" maxlength="3"/></div>
                    <div class="col-md-2"><label class="form-label small mb-0">Check-in</label><input class="form-control" type="date" name="checkin_date" required="required"/></div>
                    <div class="col-md-2"><label class="form-label small mb-0">Check-out</label><input class="form-control" type="date" name="checkout_date" required="required"/></div>
                    <div class="col-md-1"><label class="form-label small mb-0">Adults</label><input class="form-control" type="number" name="adults" value="1" min="1" max="9"/></div>
                    <div class="col-md-1"><label class="form-label small mb-0">Rooms</label><input class="form-control" type="number" name="room_quantity" value="1" min="1" max="9"/></div>
                    <div class="col-md-2"><label class="form-label small mb-0">Currency</label><input class="form-control" name="currency" value="USD"/></div>
                    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Search Hotels</button></div>
                </form>
            </div>
        </t>
    </template>

    <template id="trip_hotel_results_template" name="Trip Hotel Results">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1>Hotel Offers</h1>
                <t t-call="trip.trip_services_nav"/>
                <t t-call="trip.trip_booking_steps"/>
                <t t-if="error">
                    <div class="alert alert-warning">
                        Hotel search could not be completed.
                        <div class="small mt-1"><t t-out="error"/></div>
                    </div>
                </t>
                <t t-if="hotels">
                    <div class="row g-3">
                        <t t-foreach="hotels" t-as="item">
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title"><t t-out="item['hotel'].get('name') or 'Hotel'"/></h5>
                                        <p class="mb-1 small text-muted">
                                            <t t-out="item['hotel'].get('cityCode') or ''"/>
                                            — Hotel ID: <t t-out="item['hotel'].get('hotelId') or ''"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Room:</strong>
                                            <t t-out="(item['offer'].get('room', {}).get('description', {}) or {}).get('text') or item['offer'].get('room', {}).get('type') or 'Standard'"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Stay:</strong>
                                            <t t-out="item['offer'].get('checkInDate')"/> → <t t-out="item['offer'].get('checkOutDate')"/>
                                        </p>
                                        <p class="mb-2">
                                            <strong>Total:</strong>
                                            <t t-out="item['offer'].get('price', {}).get('total')"/>
                                            <t t-out="item['offer'].get('price', {}).get('currency')"/>
                                        </p>
                                        <form action="/trip/hotels/book" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="offer_payload" t-att-value="item.get('_payload')"/>
                                            <button type="submit" class="btn btn-primary btn-sm">Book this room</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-if="not hotels and not error">
                    <p>No hotel offers returned for this search.</p>
                </t>
            </div>
        </t>
    </template>

    <template id="cars_search_template" name="Trip Cars Search">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1>Transfers / Cars</h1>
                <t t-call="trip.trip_services_nav"/>
                <t t-call="trip.trip_booking_steps"/>
                <form action="/trip/cars/search" method="post" class="row g-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="col-md-2"><label class="form-label small mb-0">Pickup Airport</label><input class="form-control" name="pickup_location" placeholder="CDG" required="required" maxlength="3"/></div>
                    <div class="col-md-3"><label class="form-label small mb-0">Pickup Date &amp; Time</label><input class="form-control" type="datetime-local" name="pickup_datetime" required="required"/></div>
                    <div class="col-md-3"><label class="form-label small mb-0">Drop-off Address</label><input class="form-control" name="dropoff_address" placeholder="Avenue Anatole France, 5" required="required"/></div>
                    <div class="col-md-2"><label class="form-label small mb-0">City</label><input class="form-control" name="dropoff_city" placeholder="Paris" required="required"/></div>
                    <div class="col-md-1"><label class="form-label small mb-0">ZIP</label><input class="form-control" name="dropoff_zip" placeholder="75007"/></div>
                    <div class="col-md-1"><label class="form-label small mb-0">Country</label><input class="form-control" name="dropoff_country_code" placeholder="FR" required="required" maxlength="2"/></div>
                    <div class="col-md-1"><label class="form-label small mb-0">Pax</label><input class="form-control" type="number" name="passengers" value="1" min="1" max="9"/></div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Type</label>
                        <select class="form-select" name="transfer_type">
                            <option value="PRIVATE">Private</option>
                            <option value="SHARED">Shared</option>
                            <option value="TAXI">Taxi</option>
                            <option value="AIRPORT_EXPRESS">Airport Express</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Search Transfers</button></div>
                </form>
            </div>
        </t>
    </template>

    <template id="trip_car_results_template" name="Trip Car Results">
        <t t-call="website.layout">
            <div class="container my-5">
                <h1>Transfer Offers</h1>
                <t t-call="trip.trip_services_nav"/>
                <t t-call="trip.trip_booking_steps"/>
                <t t-if="error">
                    <div class="alert alert-warning">
                        Transfer search could not be completed.
                        <div class="small mt-1"><t t-out="error"/></div>
                    </div>
                </t>
                <t t-if="offers">
                    <div class="row g-3">
                        <t t-foreach="offers" t-as="offer">
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <t t-out="(offer.get('vehicle') or {}).get('description') or (offer.get('vehicle') or {}).get('code') or 'Vehicle'"/>
                                        </h5>
                                        <p class="mb-1 small text-muted">
                                            Provider: <t t-out="(offer.get('serviceProvider') or {}).get('name') or ''"/>
                                        </p>
                                        <p class="mb-1">
                                            <strong>Pickup:</strong>
                                            <t t-out="(offer.get('start') or {}).get('locationCode') or ''"/>
                                            at <t t-out="(offer.get('start') or {}).get('dateTime') or ''"/>
                                        </p>
                                        <p class="mb-2">
                                            <strong>Total:</strong>
                                            <t t-out="(offer.get('quotation') or {}).get('monetaryAmount')"/>
                                            <t t-out="(offer.get('quotation') or {}).get('currencyCode')"/>
                                        </p>
                                        <form action="/trip/cars/book" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="offer_payload" t-att-value="offer.get('_payload')"/>
                                            <button type="submit" class="btn btn-primary btn-sm">Book this transfer</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-if="not offers and not error">
                    <p>No transfer offers returned for this search.</p>
                </t>
            </div>
        </t>
    </template>

    <template id="trip_booking_error_template" name="Trip Booking Error">
        <t t-call="website.layout">
            <div class="container my-5">
                <div class="alert alert-warning">
                    <h4 class="alert-heading">Booking could not be completed</h4>
                    <p class="mb-0"><t t-out="error"/></p>
                </div>
                <a href="/trip/flights" class="btn btn-secondary">Flights</a>
                <a href="/trip/hotels" class="btn btn-secondary">Hotels</a>
                <a href="/trip/cars" class="btn btn-secondary">Transfers</a>
            </div>
        </t>
    </template>
</odoo>
