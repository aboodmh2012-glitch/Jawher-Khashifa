<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trip_api_log_action" model="ir.actions.act_window">
        <field name="name">API Logs</field>
        <field name="res_model">trip.api.log</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="trip_api_log_view_list" model="ir.ui.view">
        <field name="name">trip.api.log.list</field>
        <field name="model">trip.api.log</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'success'" decoration-danger="status == 'failed'">
                <field name="date"/>
                <field name="api_name"/>
                <field name="environment"/>
                <field name="access_mode"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="status"/>
                <field name="http_status"/>
                <field name="booking_id"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="trip_api_log_view_form" model="ir.ui.view">
        <field name="name">trip.api.log.form</field>
        <field name="model">trip.api.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="api_name"/>
                            <field name="endpoint"/>
                            <field name="environment"/>
                            <field name="access_mode"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="http_status"/>
                            <field name="booking_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request" groups="trip.group_trip_manager"><field name="request_payload" widget="text"/></page>
                        <page string="Response" groups="trip.group_trip_manager"><field name="response_payload" widget="text"/></page>
                        <page string="Error" groups="trip.group_trip_manager"><field name="error_message" widget="text"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
