<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trip_wallet_transaction_action" model="ir.actions.act_window">
        <field name="name">Wallet Transactions</field>
        <field name="res_model">trip.wallet.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="trip_wallet_transaction_view_list" model="ir.ui.view">
        <field name="name">trip.wallet.transaction.list</field>
        <field name="model">trip.wallet.transaction</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'posted'" decoration-danger="state == 'failed'">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="partner_id"/>
                <field name="transaction_type"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="booking_id"/>
                <field name="invoice_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="trip_wallet_transaction_view_form" model="ir.ui.view">
        <field name="name">trip.wallet.transaction.form</field>
        <field name="model">trip.wallet.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" string="Post" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="partner_id"/>
                            <field name="transaction_type"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="booking_id"/>
                            <field name="invoice_id"/>
                            <field name="payment_reference"/>
                            <field name="accounting_entry_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
