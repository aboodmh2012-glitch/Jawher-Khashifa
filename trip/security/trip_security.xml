<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_trip" model="ir.module.category">
        <field name="name">Trip</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_trip_user" model="res.groups">
        <field name="name">Trip User</field>
        <field name="category_id" ref="trip.module_category_trip"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_trip_manager" model="res.groups">
        <field name="name">Trip Manager</field>
        <field name="category_id" ref="trip.module_category_trip"/>
        <field name="implied_ids" eval="[(4, ref('trip.group_trip_user'))]"/>
    </record>

    <!-- Internal agents: see only bookings they created or are assigned to, inside their allowed companies. -->
    <record id="trip_booking_user_own_rule" model="ir.rule">
        <field name="name">Trip users can access own assigned bookings</field>
        <field name="model_id" ref="model_trip_booking"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('agent_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="trip_booking_manager_company_rule" model="ir.rule">
        <field name="name">Trip managers can access company bookings</field>
        <field name="model_id" ref="model_trip_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_manager'))]"/>
    </record>

    <record id="trip_booking_portal_own_rule" model="ir.rule">
        <field name="name">Portal users can only read their own trip bookings</field>
        <field name="model_id" ref="model_trip_booking"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Child records follow booking ownership. -->
    <record id="trip_passenger_user_own_rule" model="ir.rule">
        <field name="name">Trip users can access own booking passengers</field>
        <field name="model_id" ref="model_trip_passenger"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('booking_id.agent_id', '=', user.id), ('booking_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_user'))]"/>
    </record>
    <record id="trip_passenger_manager_company_rule" model="ir.rule">
        <field name="name">Trip managers can access company passengers</field>
        <field name="model_id" ref="model_trip_passenger"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_manager'))]"/>
    </record>

    <record id="trip_flight_segment_user_own_rule" model="ir.rule">
        <field name="name">Trip users can access own booking flight segments</field>
        <field name="model_id" ref="model_trip_flight_segment"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('booking_id.agent_id', '=', user.id), ('booking_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_user'))]"/>
    </record>
    <record id="trip_flight_segment_manager_company_rule" model="ir.rule">
        <field name="name">Trip managers can access company flight segments</field>
        <field name="model_id" ref="model_trip_flight_segment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_manager'))]"/>
    </record>

    <record id="trip_hotel_stay_user_own_rule" model="ir.rule">
        <field name="name">Trip users can access own booking hotel stays</field>
        <field name="model_id" ref="model_trip_hotel_stay"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('booking_id.agent_id', '=', user.id), ('booking_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_user'))]"/>
    </record>
    <record id="trip_hotel_stay_manager_company_rule" model="ir.rule">
        <field name="name">Trip managers can access company hotel stays</field>
        <field name="model_id" ref="model_trip_hotel_stay"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_manager'))]"/>
    </record>

    <record id="trip_car_rental_user_own_rule" model="ir.rule">
        <field name="name">Trip users can access own booking car/transfer records</field>
        <field name="model_id" ref="model_trip_car_rental"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('booking_id.agent_id', '=', user.id), ('booking_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_user'))]"/>
    </record>
    <record id="trip_car_rental_manager_company_rule" model="ir.rule">
        <field name="name">Trip managers can access company car/transfer records</field>
        <field name="model_id" ref="model_trip_car_rental"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_manager'))]"/>
    </record>

    <record id="trip_operation_user_own_rule" model="ir.rule">
        <field name="name">Trip users can access own operations</field>
        <field name="model_id" ref="model_trip_operation"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', '|', ('agent_id', '=', user.id), ('create_uid', '=', user.id), ('booking_id.agent_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_user'))]"/>
    </record>
    <record id="trip_operation_manager_company_rule" model="ir.rule">
        <field name="name">Trip managers can access company operations</field>
        <field name="model_id" ref="model_trip_operation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_manager'))]"/>
    </record>

    <record id="trip_pricing_rule_company_rule" model="ir.rule">
        <field name="name">Trip pricing rules by allowed companies</field>
        <field name="model_id" ref="model_trip_pricing_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_user'))]"/>
    </record>

    <record id="trip_wallet_transaction_user_own_rule" model="ir.rule">
        <field name="name">Trip users can access own wallet transactions</field>
        <field name="model_id" ref="model_trip_wallet_transaction"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('booking_id.agent_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_user'))]"/>
    </record>
    <record id="trip_wallet_transaction_manager_company_rule" model="ir.rule">
        <field name="name">Trip managers can access company wallet transactions</field>
        <field name="model_id" ref="model_trip_wallet_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_manager'))]"/>
    </record>

    <record id="trip_api_log_user_own_rule" model="ir.rule">
        <field name="name">Trip users can access own API logs</field>
        <field name="model_id" ref="model_trip_api_log"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('booking_id.agent_id', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_user'))]"/>
    </record>
    <record id="trip_api_log_manager_company_rule" model="ir.rule">
        <field name="name">Trip managers can access company API logs</field>
        <field name="model_id" ref="model_trip_api_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('trip.group_trip_manager'))]"/>
    </record>

    <!-- Portal child records follow the customer's own booking. -->
    <record id="trip_passenger_portal_own_rule" model="ir.rule">
        <field name="name">Portal users can read passengers of own bookings</field>
        <field name="model_id" ref="model_trip_passenger"/>
        <field name="domain_force">[('booking_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="trip_flight_segment_portal_own_rule" model="ir.rule">
        <field name="name">Portal users can read flight segments of own bookings</field>
        <field name="model_id" ref="model_trip_flight_segment"/>
        <field name="domain_force">[('booking_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="trip_hotel_stay_portal_own_rule" model="ir.rule">
        <field name="name">Portal users can read hotel stays of own bookings</field>
