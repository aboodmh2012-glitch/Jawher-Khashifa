<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_trip_booking_confirmation" model="mail.template">
        <field name="name">Trip Booking Confirmation</field>
        <field name="model_id" ref="model_trip_booking"/>
        <field name="subject">Booking Confirmation {{ object.name }}</field>
        <field name="email_from">{{ user.company_id.email_formatted or user.email_formatted }}</field>
        <field name="email_to">{{ object.partner_id.email or '' }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Dear <t t-out="object.partner_id.name"/>,</p>
                <p>Your booking <strong><t t-out="object.name"/></strong> has been confirmed.</p>
                <p>PNR: <t t-out="object.pnr or '-'"/></p>
                <p>Total: <t t-out="object.total_amount"/> <t t-out="object.currency_id.name"/></p>
            </div>
        </field>
    </record>
</odoo>
