<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_trip_booking" model="ir.sequence">
        <field name="name">Trip Booking</field>
        <field name="code">trip.booking</field>
        <field name="prefix">TRIP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_trip_operation" model="ir.sequence">
        <field name="name">Trip Operation</field>
        <field name="code">trip.operation</field>
        <field name="prefix">TOP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
